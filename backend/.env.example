# URL de conexión a la base de datos (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Zona horaria
TZ=Europe/Madrid

# Puerto del servidor backend
PORT=4000

# URL pública del frontend para CORS y Socket.io
FRONTEND_URL="http://localhost:5173"

# Secreto JWT para autenticación del panel
# OBLIGATORIO en producción: el backend rechaza arrancar sin él (BUG-02)
JWT_SECRET="replace_with_a_long_random_secret"

# ── Seed parametrizado (plan de modularidad M6) ──────────────────────
# Dataset de restaurante: clave de backend/prisma/restaurants/
# (meson-marinero | bar-ejemplo | el de tu restaurante)
RESTAURANT="meson-marinero"

# Modo del seed: demo (estructura + clientes y reservas de ejemplo) o
# prod (SOLO estructura + admin; exige SEED_ADMIN_EMAIL y SEED_ADMIN_PASSWORD)
SEED_MODE="demo"

# Email del admin inicial (obligatorio con SEED_MODE=prod)
SEED_ADMIN_EMAIL=""

# Contraseña del admin que crea el seed (BUG-27). En demo, si no se define,
# se usa la contraseña admin1234 (solo aceptable en desarrollo).
# Con SEED_MODE=prod es OBLIGATORIA.
SEED_ADMIN_PASSWORD=""

# BD de la suite de integración (npm run test:integration); por defecto la de
# docker-compose.test.yml
TEST_DATABASE_URL="postgresql://postgres:test@localhost:5434/resto_test"

# Google Maps API (Opcional, para geolocalización o lugares)
GOOGLE_API_KEY="your_api_key_here"
GOOGLE_PLACE_ID="your_place_id_here"

# Configuración SMTP para envío de correos
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT=465
SMTP_USER="user@example.com"
SMTP_PASS="your_app_password"
SMTP_FROM="Name <user@example.com>"

# Opcional: fuerza todos los correos a una dirección de pruebas
EMAIL_OVERRIDE_RECIPIENT=""

# N4.3: logging estructurado y monitorización
# Nivel de log de pino (trace|debug|info|warn|error). Default: info
LOG_LEVEL=info
# Sentry OPCIONAL: si defines el DSN, instala también `npm install @sentry/node`.
# Sin DSN, la monitorización es un no-op.
# SENTRY_DSN=
