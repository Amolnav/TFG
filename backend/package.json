{
  "name": "backend",
  "version": "2.0.0",
  "description": "Motor de Reservas - Backend API Completo",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:all": "npm test && npm run test:integration",
    "lint": "eslint src"
  },
  "dependencies": {
    "@prisma/client": "6.0.1",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.9.15",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.11",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "nodemon": "^3.1.9",
    "prisma": "6.0.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "vitest": "^4.1.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
