# Variables del stack docker compose (plan de modularidad M6).
# Copia este fichero a .env y ajusta los valores del despliegue.

# Identidad del despliegue (prefijo de contenedores y nombre de BD)
PROJECT_NAME=restaurant
DB_NAME=restaurant
DB_PASSWORD=root

# Puertos publicados en el host
DB_PORT=5433
BACKEND_PORT=4000
FRONTEND_PORT=5173
PGADMIN_PORT=5050

# Zona horaria del restaurante (obligatoria para el motor de reservas)
TZ=Europe/Madrid

# Seed: dataset de restaurante y modo
#   RESTAURANT: clave de backend/prisma/restaurants/ (meson-marinero | bar-ejemplo | el tuyo)
#   SEED_MODE:  demo (estructura + datos de ejemplo) | prod (solo estructura + admin)
RESTAURANT=meson-marinero
SEED_MODE=demo

# Solo SEED_MODE=prod: credenciales del administrador inicial (obligatorias)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Solo producción (docker-compose.prod.yml)
JWT_SECRET=
FRONTEND_URL=http://localhost

# N4.2: retención de backups automáticos del compose de producción (días)
BACKUP_RETENTION_DAYS=14
